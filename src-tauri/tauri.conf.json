{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nymkeep",
  "version": "0.1.0",
  "identifier": "com.klippers.nymkeep",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nymkeep",
        "width": 1060,
        "height": 760,
        "minWidth": 520,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://example.invalid/nymkeep/{{target}}/{{current_version}}"
      ],
      "dialog": false,
      "pubkey": "REPLACE_WITH_RELEASE_PUBLIC_KEY_FROM_CI"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Klippers",
    "category": "Utility",
    "resources": {
      "models/pii-model.onnx": "models/pii-model.onnx",
      "models/config.json": "models/config.json",
      "models/vocab.txt": "models/vocab.txt",
      "models/manifest.json": "models/manifest.json",
      "THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "licenses": "licenses"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
